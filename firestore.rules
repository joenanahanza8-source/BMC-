rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Player
    function isValidPlayer(data) {
      return data.keys().hasAll(['id', 'name', 'skillLevel', 'isCheckedIn', 'status', 'createdAt'])
        && data.keys().size() == 6
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.skillLevel is string && (data.skillLevel == 'beginner' || data.skillLevel == 'intermediate' || data.skillLevel == 'advanced')
        && data.isCheckedIn is bool
        && data.status is string && (data.status == 'available' || data.status == 'playing' || data.status == 'waiting')
        && data.createdAt is string;
    }

    // Validation helper for Court
    function isValidCourt(data) {
      return data.keys().hasAll(['id', 'name', 'status'])
        && (data.keys().size() == 3 || (data.keys().size() == 4 && data.keys().hasAll(['currentMatchId'])))
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.status is string && (data.status == 'empty' || data.status == 'playing')
        && (!data.keys().hasAll(['currentMatchId']) || data.currentMatchId == null || (data.currentMatchId is string && data.currentMatchId.size() <= 128));
    }

    // Validation helper for Match
    function isValidMatch(data) {
      return data.keys().hasAll(['id', 'courtId', 'type', 'teamA', 'teamB', 'status', 'shuttlecocks', 'duration', 'createdAt'])
        && (data.keys().size() == 9 || (data.keys().size() == 10 && (data.keys().hasAll(['winner']) || data.keys().hasAll(['completedAt']))) || (data.keys().size() == 11 && data.keys().hasAll(['winner', 'completedAt'])))
        && data.id is string && data.id.size() <= 128
        && data.courtId is string && data.courtId.size() <= 128
        && data.type is string && (data.type == 'singles' || data.type == 'doubles')
        && data.teamA is list && data.teamA.size() <= 10
        && data.teamB is list && data.teamB.size() <= 10
        && data.status is string && (data.status == 'playing' || data.status == 'waiting' || data.status == 'completed')
        && data.shuttlecocks is int
        && data.duration is int
        && (!data.keys().hasAll(['winner']) || data.winner == null || (data.winner is string && (data.winner == 'teamA' || data.winner == 'teamB' || data.winner == 'draw' || data.winner == '')))
        && data.createdAt is string
        && (!data.keys().hasAll(['completedAt']) || data.completedAt == null || data.completedAt is string);
    }

    // Validation helper for Booking
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'courtId', 'date', 'timeSlot', 'bookerName', 'phoneNumber', 'status', 'createdAt'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 128
        && data.courtId is string && data.courtId.size() <= 128
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timeSlot is string && data.timeSlot.size() > 0 && data.timeSlot.size() <= 100
        && data.bookerName is string && data.bookerName.size() > 0 && data.bookerName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 100
        && data.status is string && (data.status == 'pending' || data.status == 'confirmed')
        && data.createdAt is string;
    }

    // Validation helper for VehicleBorrowing
    function isValidVehicleBorrowing(data) {
      return data.keys().hasAll(['id', 'department', 'vehicleName', 'borrowDateTime', 'borrowerName', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.department is string && data.department.size() > 0 && data.department.size() <= 100
        && data.vehicleName is string && data.vehicleName.size() > 0 && data.vehicleName.size() <= 100
        && data.borrowDateTime is string && data.borrowDateTime.size() > 0 && data.borrowDateTime.size() <= 100
        && data.borrowerName is string && data.borrowerName.size() > 0 && data.borrowerName.size() <= 100
        && data.status is string && (data.status == 'borrowed' || data.status == 'returned' || data.status == 'cancelled')
        && data.createdAt is string;
    }

    // Rule blocks
    match /players/{playerId} {
      allow read: if true;
      allow create: if isValidId(playerId) && isValidPlayer(incoming());
      allow update: if isValidId(playerId) && isValidPlayer(incoming());
      allow delete: if isValidId(playerId);
    }

    match /courts/{courtId} {
      allow read: if true;
      allow create: if isValidId(courtId) && isValidCourt(incoming());
      allow update: if isValidId(courtId) && isValidCourt(incoming());
      allow delete: if isValidId(courtId);
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isValidId(matchId) && isValidMatch(incoming());
      allow update: if isValidId(matchId) && isValidMatch(incoming());
      allow delete: if isValidId(matchId);
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isValidId(bookingId) && isValidBooking(incoming());
      allow delete: if isValidId(bookingId);
    }

    match /vehicle_borrowings/{borrowingId} {
      allow read: if true;
      allow create: if isValidId(borrowingId) && isValidVehicleBorrowing(incoming());
      allow update: if isValidId(borrowingId) && isValidVehicleBorrowing(incoming());
      allow delete: if isValidId(borrowingId);
    }
  }
}
