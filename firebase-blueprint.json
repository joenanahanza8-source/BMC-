{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Represents a badminton player",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the player" },
        "name": { "type": "string", "maxLength": 100, "description": "The full name of the player" },
        "avatar": { "type": "string", "maxLength": 1000, "description": "Avatar image URL or identifier" },
        "skillLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "isCheckedIn": { "type": "boolean", "description": "Whether the player is checked-in for today's session" },
        "status": { "type": "string", "enum": ["available", "playing", "waiting"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "skillLevel", "isCheckedIn", "status", "createdAt"]
    },
    "Court": {
      "title": "Court",
      "description": "Represents a badminton court",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the court" },
        "name": { "type": "string", "maxLength": 100, "description": "The name of the court" },
        "status": { "type": "string", "enum": ["empty", "playing"] },
        "currentMatchId": { "type": "string", "maxLength": 100, "description": "The ID of the match currently played on this court" }
      },
      "required": ["id", "name", "status"]
    },
    "Match": {
      "title": "Match",
      "description": "Represents a match played on a court",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the match" },
        "courtId": { "type": "string", "description": "The court ID where the match is played" },
        "type": { "type": "string", "enum": ["singles", "doubles"] },
        "teamA": { "type": "array", "description": "Player IDs in Team A" },
        "teamB": { "type": "array", "description": "Player IDs in Team B" },
        "status": { "type": "string", "enum": ["playing", "waiting", "completed"] },
        "shuttlecocks": { "type": "number", "description": "Number of shuttlecocks used in this match" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "winner": { "type": "string", "enum": ["teamA", "teamB", "draw", ""] },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courtId", "type", "teamA", "teamB", "status", "shuttlecocks", "duration", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Represents a court booking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique ID of the booking" },
        "courtId": { "type": "string", "description": "The court ID that is booked" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "timeSlot": { "type": "string", "maxLength": 100 },
        "bookerName": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "confirmed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courtId", "date", "timeSlot", "bookerName", "phoneNumber", "status", "createdAt"]
    }
  },
  "firestore": {
    "players": {
      "schema": "Player",
      "description": "Collection of players"
    },
    "courts": {
      "schema": "Court",
      "description": "Collection of badminton courts"
    },
    "matches": {
      "schema": "Match",
      "description": "Collection of badminton matches"
    },
    "bookings": {
      "schema": "Booking",
      "description": "Collection of bookings"
    }
  }
}
